{
    "name": "tech-akm/saas-mvp-modular-boilerplate",
    "type": "project",
    "description": "Production Modular Monolith SaaS boilerplate for Laravel 11 with multi-tenancy, Stripe billing, and AI credit metering.",
    "keywords": ["laravel", "saas", "modular-monolith", "stripe", "ai-metering", "boilerplate", "tech-akm"],
    "license": "MIT",
    "authors": [
        {
            "name": "Tech AKM LLC",
            "homepage": "https://tech-akm.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/cashier": "^15.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
