APP_NAME="SaaS Modular Monolith"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=daily,json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=saas_db
DB_USERNAME=saas_user
DB_PASSWORD=saas_secret

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Stripe Cashier Configuration
STRIPE_KEY=pk_test_placeholder
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_STARTER_PRICE_ID=price_starter_test
STRIPE_PRO_PRICE_ID=price_pro_test
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_test

# Observability, Health & Telemetry
MONITORING_ENABLED=true
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_BEARER_TOKEN=
HEALTH_DISK_MIN_MB=512

# AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
