# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.php text
*.blade.php text
*.json text
*.yml text
*.yaml text
*.md text
*.xml text
*.css text
*.js text
*.sql text
*.env.example text
Dockerfile text
Makefile text

# Declare files that will always have CRLF line endings on checkout (Windows batches)
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.woff binary
*.woff2 binary

# Export-ignore: Exclude non-production files when generating release archives (git archive / composer create-project)
/.github export-ignore
/tests export-ignore
.env.example export-ignore
.gitattributes export-ignore
.gitignore export-ignore
phpunit.xml export-ignore
docker-compose.yml export-ignore
/docker export-ignore
CONTRIBUTING.md export-ignore
